# Database
DATABASE_URL=postgresql://user:password@localhost/backaspdf

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Only enable unsigned webhook requests in local development.
RESEND_WEBHOOK_ALLOW_UNSIGNED_LOCAL=false
INBOUND_EMAIL=do@backaspdf.com
FROM_EMAIL=done@backaspdf.com
FROM_NAME=Back as PDF
NOTIFY_EMAIL=hey@backaspdf.com
CONTACT_EMAIL=your-contact-email@example.com

# Billing (disabled by default)
BILLING_ENABLED=false
# Stripe variables are optional and only needed when deliberately enabling billing.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO=

# URLs
PUBLIC_APP_URL=https://backaspdf.com
API_BASE_URL=https://api.backaspdf.com

# Tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SIGNING_SECRET=your-secret-key-here
PORTAL_TOKEN_TTL_MINUTES=15

# Fair use
MONTHLY_CONVERSION_LIMIT=10

# Processing
MAX_INBOUND_SIZE_MB=10
MAX_RENDER_TIME_SECONDS=30

# Worker
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=5

# Storage (Future: S3/R2)
STORAGE_ENABLED=false
# STORAGE_BUCKET=backaspdf-pdfs
# STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=xxx
# STORAGE_SECRET_KEY=xxx

# App
ENVIRONMENT=development
DEBUG=true
